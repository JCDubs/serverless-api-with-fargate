{
	"$schema": "https://turbo.build/schema.json",
	"agentGuidance": false,
	"globalDependencies": ["biome.json", ".env.example"],
	"tasks": {
		"lint": {
			"dependsOn": ["^lint"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": {
			"dependsOn": ["^test"]
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		}
	}
}
