{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"lib": ["ES2022"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"experimentalDecorators": true,
		"strictPropertyInitialization": false,
		"outDir": "dist",
		"rootDir": "."
	},
	"include": ["bin", "lib"],
	"exclude": ["node_modules", "cdk.out", "dist"]
}
