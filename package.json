		"prepare": "bash scripts/install-hooks.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"dotenv": "^18.0.5",
		"lefthook": "^2.1.16",
		"turbo": "^2.11.6"
	}
}
