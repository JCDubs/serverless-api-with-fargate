{
	"name": "serverless-api-with-fargate",
	"private": true,
	"packageManager": "pnpm@10.33.3",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"lint": "turbo run lint",
		"format": "biome check --write .",
